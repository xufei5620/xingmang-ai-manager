  "items": [
    {
      "id": "files",
      "kind": "mcp",
      "name": "本地文件",
      "summary": "让 AI 直接读写您指定的文件夹：查看文件内容、修改文件、新建和整理文件，无需来回复制粘贴。",
      "publisher": "MCP 官方",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
      "providers": ["claude", "codex", "grok"],
      "install": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.8.31", "{{directory}}"],
        "env": {}
      },
      "inputs": [
        {
          "key": "directory",
          "label": "允许 AI 读写的文件夹",
          "placeholder": "请替换为文件夹的完整路径",
          "hint": "请仅填写允许 AI 访问的文件夹。AI 无法读取或修改该文件夹以外的文件。"
        }
      ],
      "runtime": "node",
      "network": "npm-first-run",
      "requiresAccount": false,
      "risks": ["local-fs-write"],
      "riskNote": "可删除或修改所填文件夹中的任何文件，且改动不进入回收站。建议填写具体的项目文件夹，不要填写整个 C 盘或整个用户目录。",
      "pinnedVersion": "2026.8.31",
      "marketplaceCommit": null,
      "verifiedAt": "2026-09-21",
      "note": "未填写文件夹将无法启动，因此会先预填表单，请补充路径。"
    },
    {
      "id": "browser",
      "kind": "mcp",
      "name": "浏览器",
      "summary": "让 AI 自动打开网页浏览和点击：查资料、翻阅文档、填写表单、核对页面显示的内容。",
      "publisher": "微软（Playwright 团队）",
      "homepage": "https://github.com/microsoft/playwright-mcp",
      "providers": ["claude", "codex", "grok"],
      "install": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@playwright/mcp@0.0.82"],
        "env": {}
      },
      "inputs": [],
      "runtime": "node",
      "network": "npm-first-run",
      "requiresAccount": false,
      "risks": ["browser"],
      "riskNote": "AI 会根据网页内容决定下一步操作，请勿让其操作网银、管理后台等一步操作即可能造成损失的页面。首次使用时还需下载自带的浏览器，可能需要等待几分钟。",
      "pinnedVersion": "0.0.82",
      "marketplaceCommit": null,
      "verifiedAt": "2026-09-21",
      "note": null
    },
    {
      "id": "memory",
      "kind": "mcp",
      "name": "记忆",
      "summary": "让 AI 将您交代过的事项记录在本机的文件中，更换对话后仍能记住，无需每次重新说明背景。",
      "publisher": "MCP 官方",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/memory",
      "providers": ["claude", "codex", "grok"],
      "install": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-memory@2026.8.31"],
        "env": { "MEMORY_FILE_PATH": "{{directory}}/ai-memory.jsonl" }
      },
      "inputs": [
        {
          "key": "directory",
          "label": "记忆文件存放的文件夹",
          "placeholder": "请替换为文件夹的完整路径",
          "hint": "记录的内容将保存为该文件夹中的 ai-memory.jsonl，您可随时打开查看或直接删除。"
        }
      ],
      "runtime": "node",
      "network": "npm-first-run",
      "requiresAccount": false,
      "risks": ["local-fs-write"],
      "riskNote": "仅写入自身的记忆文件，不改动其他内容。但记录内容均为明文，请勿让其记录账号密码。",
      "pinnedVersion": "2026.8.31",
      "marketplaceCommit": null,
      "verifiedAt": "2026-09-21",
      "note": "如不指定文件夹，记忆将存放在临时目录中，更换版本后会丢失，因此会先预填表单，请补充路径。"
    },
