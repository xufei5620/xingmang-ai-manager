# --- 回源访问限制（源站保护）---
# 模板：复制成同目录的 00-cf-guard.conf 再填真实值，渲染出来的 .conf 已被 .gitignore 忽略。
# 放在 extension/ 目录：宝塔重写站点配置时不会清掉这里。
# __ACME_PREFIX__ 是唯一豁免的路径前缀（证书签发用），按本站实际情况填写。
set $block_noncf 0;
if ($from_cloudflare = 0) { set $block_noncf 1; }
if ($uri ~ "^__ACME_PREFIX__") { set $block_noncf 0; }
if ($block_noncf = 1) { return 444; }
