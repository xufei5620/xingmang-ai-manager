{
  "name": "xingmang-canvas-v2",
  "private": true,
  "version": "0.1.0",
  "description": "星芒无限画布：内核来自 xingmang-canvas，按 tag 由 scripts/sync-canvas-kernel.mjs 同步进来，用主仓根目录的依赖构建（#1393）。版本范围照根目录写，锁文件由 scripts/trim-canvas-lockfile.cjs 从根目录锁文件裁出（D102）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "lucide-react": "^0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "~5.7.2",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  }
}
