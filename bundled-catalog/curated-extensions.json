    {
      "id": "github",
      "kind": "mcp",
      "name": "GitHub",
      "summary": "让 AI 直接查看您 GitHub 上的仓库、问题和合并请求，也可按您的要求在其中提交改动。",
      "publisher": "GitHub 官方",
      "homepage": "https://github.com/github/github-mcp-server",
      "providers": ["claude", "codex", "grok"],
      "install": { "type": "http", "url": "https://api.githubcopilot.com/mcp/" },
      "inputs": [],
      "runtime": "none",
      "network": "always",
      "requiresAccount": true,
      "risks": ["remote-exec"],
      "riskNote": "需要 GitHub 账号，安装后还需在工具中登录授权一次。授权后 AI 可修改该账号有权限的仓库，请勿使用公司的管理员账号授权。",
      "pinnedVersion": null,
      "marketplaceCommit": null,
      "verifiedAt": "2026-09-21",
      "note": "这是 GitHub 官方在线提供的服务，不在本机安装任何内容。"
    },
    {
      "id": "code-review",
      "kind": "plugin",
      "name": "代码审查",
      "summary": "让 Claude Code 在您提交前整体审查本次改动：从多个角度查找可能的缺陷、被忽略的报错和未同步的测试，再按把握程度排序，筛除不确定的问题。",
      "publisher": "Anthropic 官方",
      "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/code-review",
      "providers": ["claude"],
      "install": { "type": "plugin", "marketplace": "claude-plugins-official", "plugin": "code-review" },
      "inputs": [],
      "runtime": "prompt",
      "network": "install-only",
      "requiresAccount": false,
      "risks": ["extra-usage"],
      "riskNote": "仅审阅代码并给出意见，不修改您的文件。代价是一次审查需运行多轮，消耗的额度明显高于普通提问。",
      "pinnedVersion": null,
      "marketplaceCommit": "c447c3207a425bc4e2a0d068435f64b0477ae981",
      "verifiedAt": "2026-09-21",
      "note": "安装后在 Claude Code 中输入斜杠，即可在命令列表中看到 code-review。"
    },
    {
      "id": "commit-commands",
      "kind": "plugin",
      "name": "提交与合并请求",
      "summary": "将提交、推送、创建合并请求合并为一条命令：由 Claude Code 自行查看本次改动、撰写提交说明并推送，需要时一并创建合并请求。",
      "publisher": "Anthropic 官方",
      "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/commit-commands",
      "providers": ["claude"],
      "install": { "type": "plugin", "marketplace": "claude-plugins-official", "plugin": "commit-commands" },
      "inputs": [],
      "runtime": "prompt",
      "network": "install-only",
      "requiresAccount": false,
      "risks": ["git-write"],
      "riskNote": "会在当前仓库中执行提交和推送。已推送的改动需您自行在远端撤回，请勿在不确定的分支上使用。每条命令执行前 Claude Code 仍会向您确认。",
      "pinnedVersion": null,
      "marketplaceCommit": "c447c3207a425bc4e2a0d068435f64b0477ae981",
      "verifiedAt": "2026-09-21",
      "note": "安装后可在斜杠命令列表中看到 commit 和 commit-push-pr。"
    },
    {
      "id": "feature-dev",
      "kind": "plugin",
      "name": "功能开发流程",
      "summary": "开发较大的功能时，让 Claude Code 先熟悉现有代码、再确定实现方案、完成后自行复查，而非直接动手修改。",
