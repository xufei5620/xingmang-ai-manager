<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Applied to every nested helper (renderer, GPU, utility). They run V8
         as well, so they need the same MAP_JIT permission as the main app and
         nothing more; see build/entitlements.mac.plist for why library
         validation is left enabled. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
